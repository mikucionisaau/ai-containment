#fi

LESS_COMMAND=$(command -v less)
if [ -n "$LESS_COMMAND" ] ; then
    export PAGER="$LESS_COMMAND"
    if [ -n "$(command -v lesspipe)" ] ; then eval $(lesspipe) ; fi
    if [ -x "/usr/share/source-highlight/src-hilite-lesspipe.sh" ]; then
        LESS_HIGHLIGHT="| /usr/share/source-highlight/src-hilite-lesspipe.sh %s"
    fi
    export LESS="${LESS+$LESS }-R"
fi

less()
{
    # https://gist.github.com/textarcana/4611277#gistcomment-2859093
    if [ -z "$LESS_COMMAND" ]; then echo '`less` is not installed'; return; fi
    has_file=false
    all_text=true
    for arg in "$@" ; do
        if [[ "$arg" != -* ]] && [ -e "$arg" ]; then
            has_file=true
            enc=$(file -b --mime-encoding "$(realpath $arg)")
            if [[ "$enc" != *"-ascii" ]] && [ "$enc" != "utf-8" ] && [ "$enc" != "iso-8859-1" ] ; then
                all_text=false
                break
            fi
        fi
    done
    if [ "$has_file" == true ] && [ "$all_text" == true ]; then
        #LESSOPEN="$LESS_HIGHLIGHT" LESS="$LESS -N" "$LESS_COMMAND" "$@"
        LESSOPEN="$LESS_HIGHLIGHT" "$LESS_COMMAND" "$@"
        # batcat "$@"
    else
        "$LESS_COMMAND" "$@"
    fi
}

function settabwidth() {
    # https://stackoverflow.com/a/20453925/2685239
    TABWIDTH=$1
    export LESS="${LESS+$LESS }--tabs ${TABWIDTH}"
#    setterm -regtabs ${TABWIDTH} </dev/tty
    tabs -0 </dev/tty
    tabs 1$(for i in {0..40}; do echo -n ",+${TABWIDTH}"; done)
    unset TABWIDTH
}

export TIME="%U user, %S kernel, %e elapsed, %E wall-clock, %M kb_MaxRSS"


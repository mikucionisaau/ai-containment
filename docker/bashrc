# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
	. /etc/bashrc
fi

if [ -f /etc/bash.bashrc ]; then
	. /etc/bash.bashrc
fi

if [ -z "$BASH_COMPLETION" ] && [ -f /etc/bash_completion ]; then
	. /etc/bash_completion
fi

export MAVEN_HOME=/usr/share/maven
export M2_HOME=/usr/share/maven
export JUNIT4_HOME=/usr/share/java
export JUNIT5_HOME=/usr/share/java

export SYSPATH="$PATH"
export PATH="${PATH:+$PATH:}/sbin"

if [ -d "/opt/local/bin" ]; then
    export PATH="/opt/local/bin:${PATH:+:$PATH}"
fi

if [ -d "$HOME/.local/bin" ]; then
    export PATH="$HOME/.local/bin:${PATH:+:$PATH}"
fi

if [ -d "/opt/local/lib/perl5" ]; then
    PERL5LIB="/opt/local/lib/perl5${PERL5LIB:+:${PERL5LIB}}"
fi

for dir in /usr/share/man /usr/local/man /usr/local/share/man /opt/local/share/man ; do
    if [ -d "$dir" ] ; then export MANPATH="$dir${MANPATH:+:$MANPATH}" ; fi
done

if [ -d "$HOME/go-home" ] ; then
    export GO_HOME="$HOME/go-home"
    if [ -d "$GO_HOME/bin" ]; then
        export PATH="$GO_HOME/bin:$PATH"
    fi
fi


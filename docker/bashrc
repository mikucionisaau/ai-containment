# what permissions to remove for new files
umask 027

cmd=$(command -v emacs)
if [ -n "$cmd" ] ; then
	alias em="$cmd -nw -bg black"
    export EDITOR="$cmd -nw"
    export XEDITOR="$cmd -bg black"
fi

case $TERM in
    xterm*|rxvt*|screen*|tmux*|linux*)
	    if [ ! -z "$PS1" ] ; then
            # interactive prompt => use colors
	        ENABLE_COLORS=1
	        PROMPT_DIRTRIM=1
        fi
	    ;;
esac

if [ -v ENABLE_COLORS ]; then
    if [ -n "$(command -v dircolors)" ] && [ -e ~/.dircolors ] ; then
	    eval $(dircolors ~/.dircolors)
    fi
    export GREP_COLOR="mt=01;31"
    color="--color=auto"
    alias grep="grep $color"
    # Less Colors for Man Pages
    export LESS_TERMCAP_mb=$'\E[01;31m'       # begin blinking
    export LESS_TERMCAP_md=$'\E[01;38;5;74m'  # begin bold
    export LESS_TERMCAP_me=$'\E[0m'           # end mode
    export LESS_TERMCAP_se=$'\E[0m'           # end standout-mode
    export LESS_TERMCAP_so=$'\E[38;5;246m'    # begin standout-mode - info box
    export LESS_TERMCAP_ue=$'\E[0m'           # end underline
    export LESS_TERMCAP_us=$'\E[04;38;5;146m' # begin underline

#    export LESS_TERMCAP_mb=$(printf "\e[1;31m")
#    export LESS_TERMCAP_md=$(printf "\e[1;31m")
#    export LESS_TERMCAP_me=$(printf "\e[0m")
#    export LESS_TERMCAP_se=$(printf "\e[0m")
    export LESS_TERMCAP_so=$(printf "\e[1;44;33m")
#    export LESS_TERMCAP_ue=$(printf "\e[0m")
    export LESS_TERMCAP_us=$(printf "\e[1;32m")
    settabwidth 4

    if [ $(id -u) == 0 ]; then
	    hostcolor='\[\033[1;31m\]\h\[\033[0;37m\]'
    elif [ -n "$SSH_AUTH_SOCK" ]; then
	    hostcolor='\[\033[1;33m\]\h\[\033[0;37m\]'
    else
	    hostcolor='\[\033[1;32m\]\h\[\033[0;37m\]'
    fi
    # set the colorful prompt:
    if [ -n "$(command -v __git_ps1)" ] ; then
	    export GIT_PS1_SHOWDIRTYSTATE=true
	    export GIT_PS1_SHOWSTASHSTATE=true
	    #export GIT_PS1_SHOWCOLORHINTS=true
	    #export GIT_PS1_SHOWUPSTREAM=auto
	    #export GIT_PS1_SHOWUNTRACKEDFILES=true
	    PS1="$hostcolor"':$(__git_ps1 "[\[\033[1;32m\]%s\[\033[0;37m\]]")\[\033[1;34m\]\w\[\033[0;37m\]$\[\033[0m\] '
	    #PS1='\[\033[1;33m\]\h\[\033[0;37m\]:$(__git_ps1 "[\[\033[1;32m\]%s\[\033[0;37m\]]" "\\\$")\[\033[1;34m\]\w\[\033[0;37m\]$\[\033[0m\] '
	    #export PROMPT_COMMAND='__git_ps1 "\h:\w" "\\\$ "'
    else
	    PS1="$hostcolor"':\[\033[1;34m\]\w\[\033[0;37m\]$\[\033[0m\] '
    fi
    if [ "$TERM" != "linux" ] ; then
	    # set the tittle of the terminal:
	    export PROMPT_COMMAND='echo -ne "\033]0;${HOSTNAME}:${PWD}\007"'
    fi
    echo -e "\033[01;37;44m${USER}@${HOSTNAME}\033[01;37;40m $(date +'%T %A %F')\033[0m"
fi

